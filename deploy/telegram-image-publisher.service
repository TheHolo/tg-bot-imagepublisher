[Unit]
Description=Telegram Image Publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram-publisher
WorkingDirectory=/opt/telegram-image-publisher
ExecStart=/opt/telegram-image-publisher/.venv/bin/python -m app.main
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
